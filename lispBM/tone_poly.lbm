  `(,quarter . (,G5 ,C5 ,A4 ,E4))
  `(,quarter . (,F5 ,D5 ,A4 ,D4))
))

(defun play-tone (time notes) {
        (var vol 1)
        (looprange i 0 10 {
                (setq vol (* vol 0.9))
                (var ch 0)
                (loopforeach note notes {
                        (foc-play-tone ch (car note) (* vol (cdr note) (if (and (>= ch 1) (<= ch 3)) 0.7 1.0)))
                        (setq ch (+ ch 1))
                })
                (sleep (/ time 10.0))
        })
})

(defun play (x) {
        (loopforeach ls x {
                (play-tone (car ls) (cdr ls))
                (sleep 0.01)
        })
})

(play song)
