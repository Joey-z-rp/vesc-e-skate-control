(def pause '(246.942 . 0))
(def G3 '(196 . 1.0))
(def A3 '(220 . 1.0))
(def bB3 '(233.08 . 1.0))
(def C4 '(261.626 . 1.0))
(def D4 '(293.665 . 1.0))
(def E4 '(329.628 . 1.0))
(def F4 '(349.228 . 1.0))
