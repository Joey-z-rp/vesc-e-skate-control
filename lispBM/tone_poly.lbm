(def E5 '(659.25 . 1.0))
(def F5 '(698.46 . 1.0))
(def G5 '(783.99 . 1.0))
(def A5 '(880 . 1.0))

(def quarter-dot 0.67)
(def quarter 0.45)
(def eight 0.2)
(def eight-dot 0.33)
(def sixt 0.1)

(def song (list
  `(,sixt . (,C5 ,pause ,pause ,pause))
  `(,sixt . (,D5 ,pause ,pause ,pause))
  `(,sixt . (,F5 ,pause ,pause ,pause))
  `(,sixt . (,D5 ,pause ,pause ,pause))
  `(,eight-dot . (,A5 ,F5 ,D5 ,bB3))
  `(,eight-dot . (,A5 ,F5 ,D5 ,bB3))
  `(,quarter-dot . (,G5 ,E5 ,C5 ,C4))
  `(,sixt . (,C5 ,pause ,pause ,pause))
  `(,sixt . (,D5 ,pause ,pause ,pause))
  `(,sixt . (,F5 ,pause ,pause ,pause))
  `(,sixt . (,D5 ,pause ,pause ,pause))
  `(,eight-dot . (,G5 ,E5 ,C5 ,pause))
  `(,eight-dot . (,G5 ,E5 ,C5 ,pause))
  `(,quarter-dot . (,F5 ,D5 ,A4 ,D4))
  `(,sixt . (,C5 ,pause ,pause ,pause))
  `(,sixt . (,D5 ,pause ,pause ,pause))
  `(,sixt . (,F5 ,pause ,pause ,pause))
  `(,sixt . (,D5 ,pause ,pause ,pause))
  `(,quarter . (,F5 ,D5 ,bB4 ,G3))
  `(,eight . (,G5 ,pause ,pause ,pause))
  `(,eight-dot . (,E5 ,C5 ,pause ,C4))
