(def pause '(246.942 . 0))
(def c4 '(261.626 . 1.0))
(def d4 '(293.665 . 1.0))
(def e4 '(329.628 . 1.0))
(def f4 '(349.228 . 1.0))
(def g4 '(391.995 . 1.0))
(def a4 '(440 . 1.0))
(def b4 '(493.883 . 1.0))
(def c5 '(523.251 . 1.0))
(def d5 '(587.33 . 1.0))
(def e5 '(659.25 . 1.0))

(def quarter-dot 0.67)
(def quarter 0.45)
(def eight 0.2)
(def eight-dot 0.33)
(def sixt 0.1)

(def song (list
  `(,sixt . (,g4 ,pause ,pause ,pause))
  `(,sixt . (,a4 ,pause ,pause ,pause))
  `(,sixt . (,c5 ,pause ,pause ,pause))
  `(,sixt . (,a4 ,pause ,pause ,pause))
  `(,eight-dot . (,e5 ,pause ,pause ,pause))
  `(,eight-dot . (,e5 ,pause ,pause ,pause))
  `(,quarter-dot . (,d5 ,pause ,pause ,pause))
  `(,sixt . (,g4 ,pause ,pause ,pause))
  `(,sixt . (,a4 ,pause ,pause ,pause))
  `(,sixt . (,c5 ,pause ,pause ,pause))
  `(,sixt . (,a4 ,pause ,pause ,pause))
  `(,eight-dot . (,d5 ,pause ,pause ,pause))
  `(,eight-dot . (,d5 ,pause ,pause ,pause))
  `(,quarter-dot . (,c5 ,pause ,pause ,pause))
  `(,sixt . (,g4 ,pause ,pause ,pause))
  `(,sixt . (,a4 ,pause ,pause ,pause))
  `(,sixt . (,c5 ,pause ,pause ,pause))
  `(,sixt . (,a4 ,pause ,pause ,pause))
  `(,quarter . (,c5 ,pause ,pause ,pause))
  `(,eight . (,d5 ,pause ,pause ,pause))
  `(,eight-dot . (,b4 ,pause ,pause ,pause))
  `(,sixt . (,a4 ,pause ,pause ,pause))
  `(,quarter . (,g4 ,pause ,pause ,pause))
  `(,0.24 . (,g4 ,pause ,pause ,pause))
  `(,quarter . (,d5 ,pause ,pause ,pause))
  `(,quarter . (,c5 ,pause ,pause ,pause))
))

(defun play-tone (time notes) {
        (var vol 1)
        (looprange i 0 10 {
                (setq vol (* vol 0.94))
                (var ch 0)
                (loopforeach note notes {
                        (foc-play-tone ch (car note) (* vol (cdr note)))
                        (setq ch (+ ch 1))
                })
                (sleep (/ time 10.0))
        })
})

(defun play (x) {
        (loopforeach ls x {
                (play-tone (car ls) (cdr ls))
                (sleep 0.01)
        })
})

(play song)
