(def GESTURE-LO 0.03)
(def GESTURE-HI 0.2)
(def GESTURE-WINDOW 1.0)
(def MAX-ERPM 10000.0)
(def SPEED-VOL-SCALE 3.0)

(def SLAVE_CAN_ID 3)
(def CMD_SET_PARKING_BRAKE 1)
(def CMD_TOGGLE_PARKING_BRAKE 2)
(def CMD_THROTTLE 4)
(def CMD_MASTER_STATE 10)
(def CMD_VIRTUAL_THROTTLE 11)

; Virtual throttle disabled if UI goes silent for this many seconds
(def VIRT_TIMEOUT 0.5)
(def VIRT_MAX 0.4)
(def VIRT_BRAKE_MAX 1.0)

; Speed limit
(def CMD_SPEED_LIMIT 13)
(def CMD_SPEED_LIMITING_SLAVE 11)
(def SPEED_LIMIT_MS (/ 25.0 3.6))
(def THROTTLE_DEADBAND 0.15)

; Gesture tone — adjustable via UI
(def CMD_TONE_CONFIG 12)
(def tone-freq 890)
(def tone-vol-base 3.0)

(def throttle 0)
(def prev-throttle 0)
(def last-gesture-time -1)
(def last-brake-gesture-time -1)
(def brake-release-armed 1)
(def gesture-vol 0)

(def speed-limit-active 1)
(def speed-limiting 0)
(def speed-limit-cap 0.0)

(def virt-enabled 0)
(def virt-throttle 0.0)
(def virt-master-en 1)
(def virt-slave-en 1)
(def last-virt-rx (systime))

(defun in-gesture-band (val)
    (and (>= val GESTURE-LO) (<= val GESTURE-HI))
)

(defun gesture-edge (prev curr)
    (and (in-gesture-band curr) (< prev GESTURE-LO))
)

(defun in-negative-gesture-band (val)
    (and (<= val (- 0.0 GESTURE-LO)) (>= val (- 0.0 GESTURE-HI)))
)

(defun negative-gesture-edge (prev curr)
    (and (in-negative-gesture-band curr) (> prev (- 0.0 GESTURE-LO)))
)

(defun read-throttle () {
        (var rs (get-remote-state))
        (if rs (def throttle (ix rs 0)) nil)
})

; Normalize raw remote value to current-space, matching firmware deadband normalization.
; Works symmetrically for both throttle (positive) and brake (negative).
(defun norm-throttle (thr) {
    (if (> thr THROTTLE_DEADBAND)
        (/ (- thr THROTTLE_DEADBAND) (- 1.0 THROTTLE_DEADBAND))
        (if (< thr (- 0.0 THROTTLE_DEADBAND))
            (/ (+ thr THROTTLE_DEADBAND) (- 1.0 THROTTLE_DEADBAND))
            0.0))
})

(defun play-gesture-tone () {
        (var rpm-ratio (/ (abs (get-rpm)) MAX-ERPM))
        (var speed-factor (+ 1.0 (* (if (< rpm-ratio 1.0) rpm-ratio 1.0) SPEED-VOL-SCALE)))
        (setq gesture-vol (* tone-vol-base speed-factor))
        (can-cmd SLAVE_CAN_ID (str-merge
            "{ (foc-play-tone 0 " (str-from-n tone-freq) " " (str-from-n gesture-vol)
            ") (sleep 0.3) (foc-play-stop) (sleep 0.1) (foc-play-tone 0 " (str-from-n tone-freq)
            " " (str-from-n gesture-vol) ") (sleep 0.3) (foc-play-stop) }"))
        (foc-play-tone 0 tone-freq gesture-vol)
        (sleep 0.3)
        (foc-play-stop)
        (sleep 0.1)
        (foc-play-tone 0 tone-freq gesture-vol)
        (sleep 0.3)
        (foc-play-stop)
})

(defun on-brake-gesture () {
        (if (> last-brake-gesture-time 0) {
                (if (<= (secs-since last-brake-gesture-time) GESTURE-WINDOW) {
                        (can-send-sid SLAVE_CAN_ID (list CMD_TOGGLE_PARKING_BRAKE))
                        (def last-brake-gesture-time -1)
                } {
                        (def last-brake-gesture-time (systime))
                })
        } {
                (def last-brake-gesture-time (systime))
        })
})

(defun on-gesture () {
        (if (> last-gesture-time 0) {
                (if (<= (secs-since last-gesture-time) GESTURE-WINDOW) {
                        (play-gesture-tone)
                        (def last-gesture-time -1)
                } {
                        (def last-gesture-time (systime))
                })
        } {
                (def last-gesture-time (systime))
        })
})

; ── Virtual throttle UI protocol ──────────────────────────────────────────────

; CMD_MASTER_STATE (10): u8 cmd | i16 speed×100 | i16 remoteThrottle×10000
(defun send-state-to-ui () {
        (var buf (bufcreate 5))
        (bufset-u8  buf 0 CMD_MASTER_STATE)
        ; Use the enabled motor's speed — slave when master is off, master otherwise
        (var speed (if (= virt-master-en 0) (canget-speed SLAVE_CAN_ID) (get-speed)))
        (bufset-i16 buf 1 (* speed 100))
        (bufset-i16 buf 3 (* throttle 10000))
        (send-data buf)
})

; CMD_VIRTUAL_THROTTLE (11): u8 cmd | u8 enabled | i16 throttle×10000 | u8 masterEn | u8 slaveEn
(defun proc-ui-data (data) {
        (var cmd (bufget-u8 data 0))
        (if (= cmd CMD_VIRTUAL_THROTTLE) {
                (setq virt-enabled   (bufget-u8  data 1))
                (var raw (/ (bufget-i16 data 2) 10000.0))
                (setq virt-throttle
                    (if (> raw VIRT_MAX) VIRT_MAX
                        (if (< raw (- 0.0 VIRT_BRAKE_MAX)) (- 0.0 VIRT_BRAKE_MAX) raw)))
                (setq virt-master-en (bufget-u8 data 4))
                (setq virt-slave-en  (bufget-u8 data 5))
                (setq last-virt-rx   (systime))
        })
        (if (= cmd CMD_TONE_CONFIG) {
                (setq tone-freq     (bufget-i16 data 1))
                (setq tone-vol-base (/ (bufget-u8 data 3) 10.0))
        })
        (if (= cmd CMD_SPEED_LIMIT)
            (setq speed-limit-active (bufget-u8 data 1))
        )
})

(defun event-handler ()
    (loopwhile t
        (recv
            ((event-data-rx . (? data)) (proc-ui-data data))
            (_ nil)
        )
))

(event-register-handler (spawn event-handler))
(event-enable 'event-data-rx)

; Broadcast state to QML at 5 Hz, but only while virtual throttle is enabled
(spawn (fn ()
    (loopwhile t {
        (if (= virt-enabled 1) (send-state-to-ui))
        (sleep 0.2)
    })
))

; ── Main throttle loop ────────────────────────────────────────────────────────

(defun throttle-loop () {
        (var tbuf (bufcreate 3))
        (bufset-u8 tbuf 0 CMD_THROTTLE)
        (var prev-virt-active 0)
        (loopwhile t {
                (def prev-throttle throttle)
                (read-throttle)

                ; Safety: disable virtual throttle if UI goes silent
                (if (and (= virt-enabled 1) (> (secs-since last-virt-rx) VIRT_TIMEOUT))
                    (setq virt-enabled 0)
                )

                ; Virtual throttle takes effect only when real remote is neutral
                (var remote-neutral (< (abs throttle) GESTURE-LO))
                (var virt-active (if (and (= virt-enabled 1) remote-neutral) 1 0))

                ; Speed limit governor
                (var was-limiting speed-limiting)
                (var avg-speed (/ (+ (get-speed) (canget-speed SLAVE_CAN_ID)) 2.0))
                (setq speed-limiting (if (and (= speed-limit-active 1)
                                              (>= (abs avg-speed) SPEED_LIMIT_MS)) 1 0))
                ; Notify slave of speed-limiting state change on transitions
                (if (not (= was-limiting speed-limiting)) {
                    (var slbuf (bufcreate 2))
                    (bufset-u8 slbuf 0 CMD_SPEED_LIMITING_SLAVE)
                    (bufset-u8 slbuf 1 speed-limiting)
                    (can-send-sid SLAVE_CAN_ID slbuf)
                })
                (if (= speed-limiting 1) {
                        ; Seed cap in current-space on first tick over limit
                        (if (= was-limiting 0)
                            (setq speed-limit-cap (if (= virt-active 1)
                                (if (> virt-throttle 0.0) virt-throttle 0.0)
                                (norm-throttle throttle)))
                        )
                        (setq speed-limit-cap (- speed-limit-cap 0.005))
                        (if (< speed-limit-cap 0.0) (setq speed-limit-cap 0.0))
                })

                (if (= virt-active 1) {
                        (app-disable-output 100)
                        (var eff-virt (if (and (= speed-limiting 1) (> virt-throttle 0.0))
                                          (if (< virt-throttle speed-limit-cap) virt-throttle speed-limit-cap)
                                          virt-throttle))
                        (if (>= eff-virt 0.0) {
                                (if (= virt-master-en 1) (set-current-rel eff-virt))
                                (if (= virt-slave-en  1) (canset-current-rel SLAVE_CAN_ID eff-virt))
                        } {
                                (if (= virt-master-en 1) (set-brake-rel (- 0.0 eff-virt)))
                                (if (= virt-slave-en  1) (canset-brake-rel SLAVE_CAN_ID (- 0.0 eff-virt)))
                        })
                } {
                        ; Release firmware on transition out of virtual mode or speed limiting
                        (if (or (= prev-virt-active 1) (and (= was-limiting 1) (= speed-limiting 0)))
                            (app-disable-output 0)
                        )
                        (if (= speed-limiting 1) {
                                (var thr-norm (norm-throttle throttle))
                                (var eff-throttle (if (> thr-norm 0.0)
                                                     (if (< thr-norm speed-limit-cap) thr-norm speed-limit-cap)
                                                     thr-norm))
                                (app-disable-output 100)
                                (if (>= eff-throttle 0.0) {
                                    (set-current-rel eff-throttle)
                                    (canset-current-rel SLAVE_CAN_ID eff-throttle)
                                } {
                                    (set-brake-rel (- 0.0 eff-throttle))
                                    (canset-brake-rel SLAVE_CAN_ID (- 0.0 eff-throttle))
                                })
                        })
                        (bufset-i16 tbuf 1 (* throttle 10000))
                        (can-send-sid SLAVE_CAN_ID tbuf)
                })
                (setq prev-virt-active virt-active)

                ; Gesture detection runs on raw remote throttle only
                (if (and (> last-gesture-time 0)
                         (> (secs-since last-gesture-time) GESTURE-WINDOW))
                    (def last-gesture-time -1)
                )

                (if (and (> last-brake-gesture-time 0)
                         (> (secs-since last-brake-gesture-time) GESTURE-WINDOW))
                    (def last-brake-gesture-time -1)
                )

                (if (gesture-edge prev-throttle throttle)
                    (on-gesture)
                    nil
                )

                (if (negative-gesture-edge prev-throttle throttle)
                    (on-brake-gesture)
                    nil
                )

                ; Brake release tracks real throttle only — virtual mode handles its own motor control
                (if (< (abs throttle) GESTURE-LO)
                    (def brake-release-armed 1)
                )

                (if (and (or (> throttle 0.15) (< throttle -0.5))
                         (= brake-release-armed 1)) {
                    (can-send-sid SLAVE_CAN_ID (list CMD_SET_PARKING_BRAKE 0))
                    (def brake-release-armed 0)
                })

                (sleep 0.02)
        })
})

(spawn throttle-loop)
