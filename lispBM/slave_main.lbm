(def CMD_SET_PARKING_BRAKE 1)
(def CMD_TOGGLE_PARKING_BRAKE 2)
(def CMD_SET_TORQUE_VECTOR 3)
(def CMD_THROTTLE 4)
(def CMD_SPEED_LIMITING 11)
(def CMD_TV_STATE 5)
(def CMD_SET_TV_PARAMS 6)
(def CMD_SET_ABS 7)
(def CMD_SET_WOBBLE 8)
(def CMD_SET_WOBBLE_PARAMS 9)


; Globals shared across threads
(def parking-brake-active 0)
(def torque-vector-active 1)
(def speed-limiting 0)
(def throttle 0.0)       ; latest throttle from master via CAN
(def tv-left-pct 0.0)   ; slave motor output as % of intended throttle current
(def tv-right-pct 0.0)  ; master motor output as % of intended throttle current
(def TV_K 0.07)         ; yaw scalar — tunable from UI
(def TV_G 0.0007)       ; proportional gain — tunable from UI
(def abs-active 0)
(def abs-engaged-ui 0) ; latched for display — holds high for 500ms after last slip
(def wobble-active 0)
(def wobble-detected-ui 0)
(def WOBBLE_AMP_THRESHOLD 30.0) ; deg/s — tunable from UI
(def WOBBLE_SCORE_ADD 5.0)      ; tunable from UI
(def WOBBLE_SCORE_DECAY 0.05)    ; tunable from UI

(defun play-parking-brake-tone (freq) {
    (foc-play-tone 0 freq 1.5)
    (sleep 0.1)
    (foc-play-stop)
})

(defun send-state-to-ui () {
    (var buf (bufcreate 13))
    (bufset-u8  buf 0  CMD_TV_STATE)
    (bufset-u8  buf 1  parking-brake-active)
    (bufset-u8  buf 2  torque-vector-active)
    (bufset-i16 buf 3  tv-left-pct)
    (bufset-i16 buf 5  tv-right-pct)
    (bufset-u8  buf 7  abs-active)
    (bufset-u8  buf 8  abs-engaged-ui)
    (bufset-u8  buf 9  wobble-active)
    (bufset-u8  buf 10 wobble-detected-ui)
    (bufset-i16 buf 11 (* (get-speed) 100))
    (send-data buf)
})

(defun proc-ui-data (data) {
    (var cmd (bufget-u8 data 0))
    (if (= cmd CMD_SET_PARKING_BRAKE)
        (setq parking-brake-active (bufget-u8 data 1))
    )
    (if (= cmd CMD_SET_TORQUE_VECTOR)
        (setq torque-vector-active (bufget-u8 data 1))
    )
    (if (= cmd CMD_SET_TV_PARAMS) {
        (setq TV_K (/ (bufget-i16 data 1) 100.0))
        (setq TV_G (/ (bufget-i16 data 3) 10000.0))
    })
    (if (= cmd CMD_SET_ABS)
        (setq abs-active (bufget-u8 data 1))
    )
    (if (= cmd CMD_SET_WOBBLE)
        (setq wobble-active (bufget-u8 data 1))
    )
    (if (= cmd CMD_SET_WOBBLE_PARAMS) {
        (setq WOBBLE_AMP_THRESHOLD (/ (bufget-i16 data 1) 10.0))
        (setq WOBBLE_SCORE_ADD     (/ (bufget-i16 data 3) 10.0))
        (setq WOBBLE_SCORE_DECAY   (/ (bufget-i16 data 5) 100.0))
    })
})

(defun proc-can-data (id data)
    (if (= id (can-local-id)) {
        (var cmd (bufget-u8 data 0))
        (if (= cmd CMD_TOGGLE_PARKING_BRAKE) {
            (setq parking-brake-active (if (= parking-brake-active 0) 1 0))
            (send-state-to-ui)
        })
        (if (= cmd CMD_SET_PARKING_BRAKE)
            (setq parking-brake-active (bufget-u8 data 1))
        )
        (if (= cmd CMD_THROTTLE)
            (setq throttle (/ (bufget-i16 data 1) 10000.0))
        )
        (if (= cmd CMD_SPEED_LIMITING)
            (setq speed-limiting (bufget-u8 data 1))
        )
    })
)

(defun event-handler ()
    (loopwhile t
        (recv
            ((event-data-rx . (? data)) (proc-ui-data data))
            ((event-can-sid . ((? id) . (? data))) (proc-can-data id data))
            (_ nil) ; Ignore other events
)))

; Spawn the event handler thread and pass the ID it returns to C
(event-register-handler (spawn event-handler))

; Enable the custom app data event
(event-enable 'event-data-rx)
(event-enable 'event-can-sid)

; Periodically push state to QML at 10Hz
(spawn (fn ()
    (loopwhile t {
        (send-state-to-ui)
        (sleep 0.1)
    })
))

; Main loop: react to parking brake / torque vectoring state changes and run control
(defun run-main-loop () {
    (var MASTER_CAN_ID 2)
    (var BRAKE_MAX_SPEED 0.3)    ; m/s — max speed to allow activation
    (var BRAKE_MAX_CURRENT 30.0)  ; A
    (var LOOP_DT 0.02)          ; s — main loop period
    (var BRAKE_RPM_DEADBAND 10.0); RPM — ignore hall noise below this
    (var BRAKE_PITCH_GAIN 15)   ; A/rad — feedforward from slope, tune for board weight
    (var BRAKE_KP 0.01)         ; A/RPM — velocity damping, reduces oscillation
    (var BRAKE_KI 0.02)         ; A/(RPM*s) — slow trim on top of feedforward
    (var THROTTLE_DEADBAND 0.15) ; matches remote deadband
    (var TV_MIN_ROLL 0.1)       ; rad — minimum lean to apply differential
    (var TV_MAX_SPEED 7.0)      ; m/s — differential disabled above this speed
    (var TV_MAX_DELTA 0.5)      ; max delta as a fraction of intended current (0.5 = ±50%)
    (var TV_SLIP_THRESHOLD 1.7) ; m/s — speed difference between wheels indicating slip
    (var ABS_THRESHOLD 0.1)      ; m/s — per-wheel speed error to trigger brake release
    (var ABS_GRIP_MARGIN 1)    ; m/s² — allowed excess over IMU decel before trusting IMU
    (var ABS_SPEED_MIN 0.2)      ; m/s — minimum speed before ABS activates
    (var ABS_G 9.81)             ; m/s²
    (var ABS_DECEL_ALPHA 0.5)    ; EMA smoothing for wheel decel (higher = smoother, more lag)
    (var ABS_BRAKE_THRESHOLD 0.3) ; min brake input to engage ABS
    (var ABS_MIN_BRAKE 0.1)       ; brake factor applied immediately on slip
    (var ABS_MAX_BRAKE 0.6)       ; brake factor cap during wheel recovery
    (var ABS_REAPPLY_RATE 0.05)   ; factor increase per tick when wheel spins back up
    (var WOBBLE_MIN_LOOPS 2)      ; min half-wave loops (12.5 Hz at 50Hz)
    (var WOBBLE_MAX_LOOPS 7)      ; max half-wave loops (3.5 Hz at 50Hz)
    (var WOBBLE_SCORE_TRIGGER 12.0) ; score to flag wobble (~3 consecutive valid half-waves)
    (var WOBBLE_SPEED_MIN 5.0)    ; m/s — min speed to activate
    (var WOBBLE_RAMP_RATE 0.01)   ; penalty increase per tick while wobbling
    (var WOBBLE_MAX_PENALTY 0.4)  ; max current reduction (40%)
    (var prev-parking-brake-active 0)
    (var pid-integral 0.0)
    (var prev-tv-running 0)
    (var abs-theoretical-speed 0.0)
    (var abs-last-highest-speed 0.0)
    (var abs-filtered-wheel-decel 0.0)
    (var abs-engaged 0)
    (var abs-brake-factor 0.1)
    (var abs-last-left-speed 0.0)
    (var abs-last-right-speed 0.0)
    (var abs-filtered-left-accel 0.0)
    (var abs-filtered-right-accel 0.0)
    (var abs-use-imu 0)
    (var abs-ui-holdoff 0)  ; ticks remaining to keep abs-engaged-ui high
    (var ABS_UI_HOLDOFF_TICKS (/ 0.5 LOOP_DT)) ; 500ms worth of ticks
    (var prev-abs-braking 0)
    (var wobble-gyro-prev-sign 0)
    (var wobble-half-wave-loops 0)
    (var wobble-peak-amp 0.0)
    (var wobble-score 0.0)
    (var wobble-penalty 0.0)
    (var wobble-in-control 0)
    (var wobble-captured-throttle 0.0)
    (loopwhile t {

        ; --- Parking brake state change ---
        (if (not (= parking-brake-active prev-parking-brake-active)) {
            (if (= parking-brake-active 1) {
                (if (< (abs (get-speed)) BRAKE_MAX_SPEED) {
                    (setq pid-integral 0.0)
                    (play-parking-brake-tone 500)
                } {
                    (setq parking-brake-active 0)
                    (send-state-to-ui)
                })
            } {
                (set-current 0)
                (canset-current MASTER_CAN_ID 0)
                (setq pid-integral 0.0)
                (can-cmd MASTER_CAN_ID "(app-disable-output 0)")
                (play-parking-brake-tone 700)
            })
            (setq prev-parking-brake-active parking-brake-active)
        })

        ; --- Parking brake hold control ---
        (if (= parking-brake-active 1) {
            (can-cmd MASTER_CAN_ID "(app-disable-output 100)")
            (var pitch (ix (get-imu-rpy) 1))
            (var base-current (* BRAKE_PITCH_GAIN pitch))

            (var rpm (get-rpm))
            (var rpm-err (if (< (abs rpm) BRAKE_RPM_DEADBAND) 0.0 (- 0.0 rpm)))

            (setq pid-integral (+ pid-integral (* rpm-err LOOP_DT)))
            (var integral-max (/ BRAKE_MAX_CURRENT BRAKE_KI))
            (if (> pid-integral integral-max) (setq pid-integral integral-max))
            (if (< pid-integral (- 0.0 integral-max)) (setq pid-integral (- 0.0 integral-max)))

            (var hold-current (+ base-current (* BRAKE_KP rpm-err) (* BRAKE_KI pid-integral)))

            (if (> hold-current BRAKE_MAX_CURRENT) (setq hold-current BRAKE_MAX_CURRENT))
            (if (< hold-current (- 0.0 BRAKE_MAX_CURRENT)) (setq hold-current (- 0.0 BRAKE_MAX_CURRENT)))
            (set-current hold-current)
            (canset-current MASTER_CAN_ID hold-current)
        })

        ; --- Torque vectoring ---
        (var roll (ix (get-imu-rpy) 0))
        (var left-speed (get-speed))
        (var right-speed (canget-speed MASTER_CAN_ID))
        (var velocity (if (> (abs (- left-speed right-speed)) TV_SLIP_THRESHOLD)
                          (if (< (abs left-speed) (abs right-speed)) left-speed right-speed)
                          (/ (+ left-speed right-speed) 2.0)))
        (var tv-running (if (and (= torque-vector-active 1)
                                 (= speed-limiting 0)
                                 (= parking-brake-active 0)
                                 (> (abs roll) TV_MIN_ROLL)
                                 (< (abs velocity) TV_MAX_SPEED)
                                 (> throttle THROTTLE_DEADBAND)) 1 0))

        (if (not (= tv-running prev-tv-running)) {
            (if (= tv-running 0) {
                (if (= speed-limiting 0)
                    (can-cmd MASTER_CAN_ID "(app-disable-output 0)")
                )
                (setq tv-left-pct 0.0)
                (setq tv-right-pct 0.0)
            })
            (setq prev-tv-running tv-running)
        })

        (if (= tv-running 1) {
            (can-cmd MASTER_CAN_ID "(app-disable-output 100)")

            (var throttle-scaled (/ (- throttle THROTTLE_DEADBAND) (- 1.0 THROTTLE_DEADBAND)))
            (var yaw-rate (ix (get-imu-gyro) 2))
            (var target-yaw (* velocity roll TV_K))
            (var yaw-error (- target-yaw yaw-rate))
            (var delta (* yaw-error TV_G))

            (var max-delta (* throttle-scaled TV_MAX_DELTA))
            (if (> delta max-delta) (setq delta max-delta))
            (if (< delta (- 0.0 max-delta)) (setq delta (- 0.0 max-delta)))
            (var left-rel (+ throttle-scaled delta))
            (var right-rel (- throttle-scaled delta))

            (if (> left-rel 1.0) (setq left-rel 1.0))
            (if (< left-rel -1.0) (setq left-rel -1.0))
            (if (> right-rel 1.0) (setq right-rel 1.0))
            (if (< right-rel -1.0) (setq right-rel -1.0))

            (set-current-rel left-rel)
            (canset-current-rel MASTER_CAN_ID right-rel)
            (setq tv-left-pct (* (/ left-rel throttle-scaled) 100))
            (setq tv-right-pct (* (/ right-rel throttle-scaled) 100))
        })

        ; --- ABS ---
        (var abs-braking (if (and (= abs-active 1) (< throttle (- 0.0 ABS_BRAKE_THRESHOLD))) 1 0))
        (if (= abs-braking 1) {
            ; Pitch-corrected IMU deceleration in m/s²
            (var abs-pitch (ix (get-imu-rpy) 1))
            (var imu-accel (get-imu-acc))
            (var ax (ix imu-accel 0))
            (var az (ix imu-accel 2))
            ; Z axis should read ~1g when IMU is working — near 0 means unavailable
            (var imu-ok (> (abs az) 0.5))
            (var true-vehicle-decel (abs (* ABS_G (- ax (sin abs-pitch)))))

            (if imu-ok {
            ; Always integrate IMU to keep theoretical speed current
            (setq abs-theoretical-speed (- abs-theoretical-speed (* true-vehicle-decel LOOP_DT)))
            (if (< abs-theoretical-speed 0.0) (setq abs-theoretical-speed 0.0))

            ; Rate at which the fastest wheel dropped this tick — filtered to reduce noise
            (var highest-wheel-speed (if (> (abs left-speed) (abs right-speed))
                                         (abs left-speed) (abs right-speed)))
            (var raw-wheel-decel (/ (- abs-last-highest-speed highest-wheel-speed) LOOP_DT))
            (setq abs-filtered-wheel-decel (+ (* ABS_DECEL_ALPHA abs-filtered-wheel-decel)
                                               (* (- 1.0 ABS_DECEL_ALPHA) raw-wheel-decel)))

            ; Condition A: sudden violent drop — trigger IMU mode
            (if (> abs-filtered-wheel-decel (+ true-vehicle-decel ABS_GRIP_MARGIN))
                (setq abs-use-imu 1)
                ; Condition B: no sudden drop — but are we still in an active skid?
                (if (and (= abs-use-imu 1)
                         (> (- abs-theoretical-speed highest-wheel-speed) ABS_THRESHOLD))
                    nil  ; still slipping — latch IMU mode
                    (setq abs-use-imu 0)  ; wheel caught up — return to wheel mode
                )
            )

            (var predicted-speed (if (= abs-use-imu 1) abs-theoretical-speed highest-wheel-speed))

            ; Anchor theoretical speed to reality whenever wheels are trustworthy
            (if (= abs-use-imu 0)
                (setq abs-theoretical-speed highest-wheel-speed)
            )
            (setq abs-last-highest-speed highest-wheel-speed)

            ; Per-wheel ABS: release brake if wheel has fallen behind predicted speed
            (var left-slip  (and (> predicted-speed ABS_SPEED_MIN)
                                 (> (- predicted-speed (abs left-speed))  ABS_THRESHOLD)))
            (var right-slip (and (> predicted-speed ABS_SPEED_MIN)
                                 (> (- predicted-speed (abs right-speed)) ABS_THRESHOLD)))

            (var brake-rel (/ (- (abs throttle) THROTTLE_DEADBAND) (- 1.0 THROTTLE_DEADBAND)))

            ; Per-wheel acceleration — positive means spinning back up
            (var raw-left-accel  (/ (- (abs left-speed)  abs-last-left-speed)  LOOP_DT))
            (var raw-right-accel (/ (- (abs right-speed) abs-last-right-speed) LOOP_DT))
            (setq abs-filtered-left-accel  (+ (* ABS_DECEL_ALPHA abs-filtered-left-accel)
                                               (* (- 1.0 ABS_DECEL_ALPHA) raw-left-accel)))
            (setq abs-filtered-right-accel (+ (* ABS_DECEL_ALPHA abs-filtered-right-accel)
                                               (* (- 1.0 ABS_DECEL_ALPHA) raw-right-accel)))

            ; Single factor for both wheels — ramp up if either wheel is recovering
            (var any-slip (or left-slip right-slip))
            (if any-slip {
                (var recovering (or (> abs-filtered-left-accel 0.0)
                                    (> abs-filtered-right-accel 0.0)))
                (if recovering {
                    (setq abs-brake-factor (+ abs-brake-factor ABS_REAPPLY_RATE))
                    (if (> abs-brake-factor ABS_MAX_BRAKE) (setq abs-brake-factor ABS_MAX_BRAKE))
                } {
                    (setq abs-brake-factor ABS_MIN_BRAKE)
                })
            })

            ; Apply same factor to both wheels — symmetric braking prevents truck shake
            (if any-slip {
                (if (= abs-engaged 0)
                    (can-cmd MASTER_CAN_ID "(app-disable-output 100)")
                )
                (setq abs-engaged 1)
                (setq abs-engaged-ui 1)
                (setq abs-ui-holdoff ABS_UI_HOLDOFF_TICKS)
                (set-brake-rel    (* abs-brake-factor brake-rel))
                (canset-brake-rel MASTER_CAN_ID (* abs-brake-factor brake-rel))
            } {
                ; Both wheels caught up — release control back to remote
                (if (= abs-engaged 1)
                    (can-cmd MASTER_CAN_ID "(app-disable-output 0)")
                )
                (setq abs-engaged 0)
                (if (> abs-ui-holdoff 0)
                    (setq abs-ui-holdoff (- abs-ui-holdoff 1))
                    (setq abs-engaged-ui 0)
                )
            })

            (setq abs-last-left-speed  (abs left-speed))
            (setq abs-last-right-speed (abs right-speed))
            }) ; end imu-ok guard
        } {
            ; Transition: just stopped braking — reset state once
            (if (= prev-abs-braking 1) {
                (if (= abs-engaged 1)
                    (can-cmd MASTER_CAN_ID "(app-disable-output 0)")
                )
                (setq abs-theoretical-speed 0.0)
                (setq abs-last-highest-speed 0.0)
                (setq abs-filtered-wheel-decel 0.0)
                (setq abs-use-imu 0)
                (setq abs-engaged 0)
                (setq abs-last-left-speed 0.0)
                (setq abs-last-right-speed 0.0)
                (setq abs-filtered-left-accel 0.0)
                (setq abs-filtered-right-accel 0.0)
                (setq abs-engaged-ui 0)
                (setq abs-ui-holdoff 0)
            })
        })
        (setq prev-abs-braking abs-braking)

        ; --- Speed wobble detection & control ---
        (if (= wobble-active 1) {
            (var gyro-x (ix (get-imu-gyro) 0))
            (var gyro-sign (if (>= gyro-x 0.0) 1 -1))

            ; Track peak amplitude and loop count for this half-wave
            (if (> (abs gyro-x) wobble-peak-amp) (setq wobble-peak-amp (abs gyro-x)))
            (setq wobble-half-wave-loops (+ wobble-half-wave-loops 1))

            ; Decay score each tick — valid events must add faster than decay removes
            (setq wobble-score (- wobble-score WOBBLE_SCORE_DECAY))
            (if (< wobble-score 0.0) (setq wobble-score 0.0))

            ; Zero-crossing: evaluate completed half-wave
            (if (and (not (= wobble-gyro-prev-sign 0))
                     (not (= gyro-sign wobble-gyro-prev-sign))) {
                (if (and (>= wobble-half-wave-loops WOBBLE_MIN_LOOPS)
                         (<= wobble-half-wave-loops WOBBLE_MAX_LOOPS)
                         (> wobble-peak-amp WOBBLE_AMP_THRESHOLD)
                         (> (abs velocity) WOBBLE_SPEED_MIN)) {
                    (setq wobble-score (+ wobble-score WOBBLE_SCORE_ADD))
                    (if (> wobble-score WOBBLE_SCORE_TRIGGER) (setq wobble-score WOBBLE_SCORE_TRIGGER))
                })
                (setq wobble-half-wave-loops 0)
                (setq wobble-peak-amp 0.0)
            })
            (setq wobble-gyro-prev-sign gyro-sign)

            ; Control: take over when triggered, hold after wobble clears
            (var wobble-triggered (>= wobble-score WOBBLE_SCORE_TRIGGER))
            ; Compute throttle-scaled once — used for both capture and release
            (var throttle-scaled (if (> throttle THROTTLE_DEADBAND)
                                     (/ (- throttle THROTTLE_DEADBAND) (- 1.0 THROTTLE_DEADBAND))
                                     0.0))

            (if wobble-triggered {
                (if (= wobble-in-control 0) {
                    ; Capture throttle at the moment control is taken
                    (setq wobble-in-control 1)
                    (setq wobble-captured-throttle throttle-scaled)
                })
                (setq wobble-penalty (+ wobble-penalty WOBBLE_RAMP_RATE))
                (if (> wobble-penalty WOBBLE_MAX_PENALTY) (setq wobble-penalty WOBBLE_MAX_PENALTY))
                (setq wobble-detected-ui 1)
            })

            (if (= wobble-in-control 1) {
                (can-cmd MASTER_CAN_ID "(app-disable-output 100)")
                (var max-output (- wobble-captured-throttle wobble-penalty))
                (if (< max-output 0.0) (setq max-output 0.0))
                (if (<= throttle-scaled max-output) {
                    ; Rider backed off to/below penalized level — release
                    (can-cmd MASTER_CAN_ID "(app-disable-output 0)")
                    (setq wobble-in-control 0)
                    (setq wobble-penalty 0.0)
                } {
                    ; Cap throttle at captured - penalty; rider cannot exceed this
                    (set-current-rel max-output)
                    (canset-current-rel MASTER_CAN_ID max-output)
                })
            })

            (setq wobble-detected-ui (if (or wobble-triggered (= wobble-in-control 1)) 1 0))
        } {
            ; Wobble feature disabled — release if we had control
            (if (= wobble-in-control 1) {
                (can-cmd MASTER_CAN_ID "(app-disable-output 0)")
                (setq wobble-in-control 0)
                (setq wobble-penalty 0.0)
                (setq wobble-captured-throttle 0.0)
            })
            (setq wobble-score 0.0)
            (setq wobble-gyro-prev-sign 0)
            (setq wobble-half-wave-loops 0)
            (setq wobble-peak-amp 0.0)
            (setq wobble-detected-ui 0)
        })

        (sleep LOOP_DT)
    })
})
(run-main-loop)
